# ============================================================================
#  .env.example — plantilla de variables de entorno (ETAPA 2)
# ----------------------------------------------------------------------------
#  Copie este archivo como  .env  y rellene los valores. El archivo .env está
#  en .gitignore y NUNCA debe subirse a Git (corrige V06).
#
#  En Windows PowerShell también puede definir estas variables sin archivo:
#      $env:APP_SECRET_KEY = "..."
#      php -S 127.0.0.1:8000 -t public
#
#  Genere valores aleatorios con:
#      php -r "echo bin2hex(random_bytes(32));"            # para APP_SECRET_KEY
#      php -r "echo sodium_bin2base64(random_bytes(32), SODIUM_BASE64_VARIANT_ORIGINAL);"  # clave de cifrado
# ============================================================================

# Clave de sesión/propósito general (32 bytes hex recomendados).
APP_SECRET_KEY=CAMBIE_ESTE_VALOR_ficticio_de_laboratorio

# Clave de cifrado Sodium (32 bytes en base64). Si se deja vacía, la app genera
# una y la guarda en storage/keys/secretbox.key (fuera de public/ y de Git).
APP_ENCRYPTION_KEY=

# Credencial ficticia de ejemplo (demostración de gestión de secretos).
DB_PASSWORD=CAMBIE_ESTE_VALOR_ficticio
